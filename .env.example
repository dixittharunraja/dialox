# Copy to .env to override defaults. Every value is optional: with none set, the stack runs
# fully offline using the built-in telephony simulator and seeded demo accounts.

# Host ports
HTTP_PORT=8080
SMTP_PORT=2525

# Mail domain for phone-number addresses (9876543210@dialox.local) and the country whose
# numbers use the short national form in addresses.
MAIL_DOMAIN=dialox.local
DEFAULT_COUNTRY=IN

# Public URL of the web entry point. Used in SMS links, the WebOTP "@host #code" line and
# Twilio webhook signature checks, so it must match the URL configured in the Twilio console.
PUBLIC_URL=http://localhost:8080

POSTGRES_PASSWORD=dialox

# Twilio (trial works). When all three are set, OTP/SMS go through Twilio instead of the simulator.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Number shown to users for IVR/SMS registration (defaults to TWILIO_FROM_NUMBER).
TOLL_FREE_NUMBER=

# "none" forces password authentication even when an OTP gateway exists.
OTP_MODE=
# New-mail SMS text; {sender} and {subject} are substituted.
SMS_TEMPLATE=You have received an email from {sender}. Subject: {subject}.

# Optional outbound relay for mail to non-Dialox domains, e.g. smtp://user:pass@smtp.example.com:587
SMTP_RELAY_URL=

SIMULATOR_ENABLED=true
SEED_DEMO=true
