{
  "name": "dialox",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "knip": "knip",
    "dup": "jscpd apps/api/src apps/client/src packages/shared/src",
    "check": "prettier --check . && pnpm lint && pnpm typecheck && pnpm knip && pnpm dup",
    "db:generate": "pnpm --filter @dialox/api db:generate",
    "build:android": "pnpm --filter @dialox/client run build:android",
    "install:android": "pnpm --filter @dialox/client run install:android",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^5.64.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,css,yml,yaml,md}": "prettier --write"
  }
}
