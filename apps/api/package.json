    "fastify": "^5.6.1",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.6",
    "postgres": "^3.4.7",
    "smtp-server": "^3.14.0",
    "twilio": "^5.10.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@dialox/shared": "workspace:*",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/smtp-server": "^3.5.12",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "tsup": "^8.5.0",
